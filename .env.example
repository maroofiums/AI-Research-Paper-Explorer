# arXiv API
ARXIV_API_BASE_URL=http://export.arxiv.org/api/query

# Local storage
DATA_DIR=./data

# Chunking (measured in words, not tokens — see app/services/chunker.py)
CHUNK_SIZE_WORDS=400
CHUNK_OVERLAP_WORDS=50

# Phase 2 — embedding models (used later, kept here so config.py doesn't need edits then)
PAPER_EMBEDDING_MODEL=allenai/specter2_base
CHUNK_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
